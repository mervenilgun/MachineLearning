   "source": [
    "# her bir çapraz doğrulama katı için doğruluk skorları bar plot şeklinde\n",
    "from sklearn.datasets import load_iris\n",
    "from sklearn.model_selection import cross_val_score\n",
    "from sklearn.svm import SVC\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Iris veri setini yükleme\n",
    "iris = load_iris()\n",
    "X = iris.data\n",
    "y = iris.target\n",
    "\n",
    "# Destek vektör makinesi sınıflandırma modeli oluşturma\n",
    "model = SVC(kernel='linear')\n",
    "\n",
    "# 5 kat çapraz doğrulama ile doğruluk skorlarını hesaplama\n",
    "scores = cross_val_score(model, X, y, cv=5)\n",
    "\n",
    "# Her bir kat için elde edilen doğruluk skorlarını yazdırma\n",
    "print(\"Doğruluk Skorları:\", scores)\n",
    "\n",
    "# Ortalama doğruluk skorunu yazdırma\n",
    "print(\"Ortalama Doğruluk Skoru:\", scores.mean())\n",
    "\n",
    "# Bar plot için verileri hazırlama\n",
    "cv_range = range(1, 6)\n",
    "plt.bar([f\"fred{i}\" for i in cv_range], scores, color='pink')\n",
    "plt.xlabel('Çapraz Doğrulama Kategorileri')\n",
    "plt.ylabel('Doğruluk Skoru')\n",
    "plt.title('Çapraz Doğrulama Skorları')\n",
    "plt.ylim(0.9, 1.0)  # Y eksenini 0.9 ile 1 arasında sınırlıyoruz\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
  }
